# Copie ce fichier en .env et remplis les valeurs. Ne commite jamais .env.

# MetaTrader 5 (COMPTE DEMO uniquement en phase 8)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Fournisseurs de donnees externes (si utilises)
DATA_PROVIDER_API_KEY=
FRED_API_KEY=

# Securite : aucune execution d'ordre reel tant que cette valeur n'est pas "true"
# ET qu'une etape de validation distincte a ete implementee. Laisser a false.
ALLOW_LIVE_EXECUTION=false
